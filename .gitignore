# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any folder, e.g. reverse-engineering/node_modules)
node_modules/

# Supabase CLI local state (linked project, versions)
supabase/.temp/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Instagram scrape (raw media, not committed)
scraped/
*cookies*.txt

# generated: knowledge graph and Python bytecode
graphify-out/
__pycache__/

# Google OAuth client secrets (never commit)
client_secret_*.json
