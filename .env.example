# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for share links and OAuth callbacks (optional in dev).
NEXT_PUBLIC_SITE_URL=

# Google Sheets integration (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI configured in Google Cloud Console.
# Defaults to <origin>/api/integrations/google/callback
GOOGLE_REDIRECT_URI=
# Long random string used to encrypt refresh tokens and sign OAuth state.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Secret that lets a scheduler call /api/cron/sheets (Authorization: Bearer <value>)
CRON_SECRET=
